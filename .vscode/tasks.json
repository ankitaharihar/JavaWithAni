{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Current Java File",
      "type": "shell",
      "command": "javac",
      "args": [
        "-d",
        "${workspaceFolder}/bin",
        "${file}"
      ],
      "problemMatcher": [
        "$javac"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
